<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MultiHubApp.Views.HaberDetailPage"
    Title="News Detail"
    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Top: title area -->
        <StackLayout Padding="12" Spacing="6">
            <Label x:Name="TitleLabel"
                   FontSize="20"
                   FontAttributes="Bold"
                   LineBreakMode="TailTruncation"
                   TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />

            <HorizontalStackLayout Spacing="12">
                <Label x:Name="SourceLabel"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />
                <Label x:Name="DateLabel"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#555555, Dark=#AAAAAA}" />
            </HorizontalStackLayout>
        </StackLayout>

        <!-- Image -->
        <Image x:Name="HeaderImage"
               Grid.Row="1"
               HeightRequest="180"
               Aspect="AspectFill"
               IsVisible="False" />

        <!-- WebView / Summary area -->
        <Grid Grid.Row="2">
            <WebView x:Name="ContentWebView"
                     Navigating="ContentWebView_Navigating"
                     Navigated="ContentWebView_Navigated" />

            <ActivityIndicator x:Name="WebLoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <!-- Bottom toolbar -->
        <Grid Grid.Row="3" Padding="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Left button -->
            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                <Button x:Name="BtnToggleView"
                        Text="View original"
                        Clicked="OnToggleViewClicked"
                        BackgroundColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}"
                        TextColor="{AppThemeBinding Light=#FFFFFF, Dark=#000000}"
                        CornerRadius="8"/>
            </HorizontalStackLayout>

            <!-- Right buttons -->
            <HorizontalStackLayout Grid.Column="2" Spacing="8" HorizontalOptions="End">
                <Button Text="Share"
                        Clicked="OnShareClicked"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />

                <Button Text="Open in Browser"
                        Clicked="OnOpenInBrowserClicked"
                        BackgroundColor="Transparent"
                        TextColor="{AppThemeBinding Light=#000000, Dark=#FFFFFF}" />
            </HorizontalStackLayout>

        </Grid>
    </Grid>
</ContentPage>
